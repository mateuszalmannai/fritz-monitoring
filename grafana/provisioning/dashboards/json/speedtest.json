    },
    {
      "id": 3,
      "type": "stat",
      "title": "Download vs. sync",
      "description": "Last download test as a share of the FRITZ!Box's current DSL sync rate. ~90-95 % is normal (protocol overhead).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * last_over_time(speedtest_download_bits_per_second[1d]) / scalar(max(fritz_dsl_datarate_kbps{direction=\"rx\",type=\"curr\"}) * 1000)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      }
    },
