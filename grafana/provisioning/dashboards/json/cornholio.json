    {
      "type": "stat",
      "title": "Scrape targets",
      "description": "Whether Prometheus could read each target at its last scrape (up). The speed test is read only every 8 h.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job!=\"speedtest\"}",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "last_over_time(up{job=\"speedtest\"}[8h30m])",
          "legendFormat": "speedtest (last test)",
          "refId": "B",
          "instant": true,
          "range": false
