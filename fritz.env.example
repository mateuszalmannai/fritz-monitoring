# Copy to "fritz.env" and fill in. Keep this file private.
FRITZ_HOSTNAME=192.168.178.1
FRITZ_NAME=FRITZ!Box
FRITZ_USERNAME=monitoring
# Max. 32 characters - FRITZ!OS silently truncates longer passwords (-> 401 errors).
# Use single quotes if it contains $, # or spaces.
FRITZ_PASSWORD=your-password-here

# Per-device details. Only needed for dashboard 17751's per-device panels; the rest of 17751 and 13983 work without.
# Slow (20+ s per scrape) and adds load on the box - leave off to start.
FRITZ_HOST_INFO=false

# Per-client Wi-Fi signal strength and link speed (one series per connected client, identified by
# IP and MAC only). Light: adds ~2 s per scrape.
FRITZ_WIFI_CLIENT_INFO=true

# fritz-extras (online devices by name): leave empty to name every device, or list device names
# or MAC addresses (comma-separated) to name only those; the others are only counted.
DEVICE_ALLOWLIST=
